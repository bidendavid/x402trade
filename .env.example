# ── App server ─────────────────────────────────────────────────────────────────

# Database (data server IP)
DB_HOST=YOUR_DATA_SERVER_IP
DB_PASSWORD=agentpass

# Redis (data server IP)
REDIS_HOST=YOUR_DATA_SERVER_IP
REDIS_PASSWORD=

# NATS (internal, same compose network)
NATS_URL=nats://nats:4222

# GitHub Container Registry (for Docker image pulls)
GITHUB_REPO=bidendavid/x402trade

# ── x402-gateway ───────────────────────────────────────────────────────────────
PORT=8080
X402_PAYMENT_ADDRESS=0xYOUR_COLLECTION_WALLET
RISK_CONTROL_URL=http://background-worker:8083

# ── wallet-service ─────────────────────────────────────────────────────────────
WALLET_PORT=8082
PLATFORM_FEE_WALLET=0xYOUR_FEE_WALLET
TRADING_VAULT_ADDRESS=0xe73cB4ebe8315ecadF73a5CE2620389440a992e4
EXCHANGE_BACKEND_KEY=0xYOUR_BACKEND_SIGNING_PRIVATE_KEY
BASE_RPC_URL=https://mainnet.base.org
USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bA02913C

# ── background-worker ──────────────────────────────────────────────────────────
BACKGROUND_PORT=8083
ADMIN_SECRET=your-admin-secret-here

# ── Data server ────────────────────────────────────────────────────────────────

# Grafana
GRAFANA_PASSWORD=your-grafana-password

# ── Contracts (Hardhat deployment) ─────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0x...
BASESCAN_API_KEY=your-basescan-api-key
# After deployment, paste the result from contracts/deployments.json:
# TRADING_VAULT_ADDRESS=0x...

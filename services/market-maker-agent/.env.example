# Required: your agent wallet private key (keep this secret!)
PRIVATE_KEY=0xyour_private_key_here

# x402Trade API endpoint (default: mainnet)
GATEWAY_URL=https://api.getx402.trade

# Trading pair
PAIR=ETH-USDC

# Order size per level (in ETH)
ORDER_SIZE=0.05

# Number of price levels on each side of the book
LEVELS=3

# Spread between each level (0.002 = 0.2%)
SPREAD=0.002

# How often to refresh orders, in seconds
REFRESH_SECS=30

# Risk controls — bot stops if these are breached
MAX_PRICE_DRIFT_PCT=10
MIN_USDC_BALANCE=50
MIN_ETH_BALANCE=0.05

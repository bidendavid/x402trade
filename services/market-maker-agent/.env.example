# ── Required ──────────────────────────────────────────────────────────────────
PRIVATE_KEY=0x_your_private_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
GATEWAY_URL=https://api.getx402.trade
PAIR=ETH-USDC

# Order size in base token (ETH)
ORDER_SIZE=0.05

# Number of price levels on each side (3 = 3 buy + 3 sell)
LEVELS=3

# Spread per level (0.002 = 0.2%)
SPREAD=0.002

# How often to refresh orders (seconds)
REFRESH_SECS=30

# ── Risk controls ─────────────────────────────────────────────────────────────
# Stop if price moves more than X% from start
MAX_PRICE_DRIFT_PCT=10

# Stop if USDC balance drops below this
MIN_USDC_BALANCE=50

# Stop if ETH balance drops below this
MIN_ETH_BALANCE=0.05
